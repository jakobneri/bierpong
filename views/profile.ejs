<%- include('partials/header') %>

<div class="profile-header">
  <%- include('partials/avatar', { avatarFilename: stats.avatar_filename, avatarUsername: stats.username, avatarSize: 'lg' }) %>
  <div>
    <h1 class="profile-title">Statistik: <%= stats.username %></h1>
    <% if (isOwnProfile) { %>
      <% if (avatarError) { %><p class="error"><%= avatarError %></p><% } %>
      <form action="/account/avatar" method="POST" enctype="multipart/form-data" class="avatar-upload-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="file" name="avatar" accept="image/png,image/jpeg,image/webp,image/gif" required />
        <button type="submit" class="button small secondary">Profilbild ändern</button>
      </form>
    <% } %>
  </div>
</div>

<% if (isOwnProfile && savedPresets.length > 0) { %>
  <h2>Meine gespeicherten Hausregeln</h2>
  <ul class="match-list">
    <% savedPresets.forEach(sp => { %>
      <li class="card match-item">
        <div>
          <strong><%= sp.name %></strong>
          <div class="hint small"><%= sp.throws_per_turn %> Wurf<%= sp.throws_per_turn === 1 ? '' : '/Würfe' %> pro Wechsel<%= sp.bomb_enabled ? ', Bomben-Regel aktiv' : '' %></div>
        </div>
        <form action="/account/presets/<%= sp.id %>/delete" method="POST" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="button small secondary">Löschen</button>
        </form>
      </li>
    <% }) %>
  </ul>
<% } %>

<div class="grid">
  <div class="card stat-card">
    <span class="stat-label">Spiele</span>
    <span class="stat-value"><%= stats.games %></span>
  </div>
  <div class="card stat-card">
    <span class="stat-label">Siege</span>
    <span class="stat-value"><%= stats.wins %></span>
  </div>
  <div class="card stat-card">
    <span class="stat-label">Niederlagen</span>
    <span class="stat-value"><%= stats.losses %></span>
  </div>
  <div class="card stat-card">
    <span class="stat-label">Winrate</span>
    <span class="stat-value"><%= stats.winRate.toFixed(1) %>%</span>
  </div>
  <div class="card stat-card">
    <span class="stat-label">Becher (F/G)</span>
    <span class="stat-value"><%= stats.cups_for %> / <%= stats.cups_against %></span>
  </div>
</div>

<h2>Gegen wen ist <%= stats.username %> gut?</h2>
<% if (opponents.length === 0) { %>
  <p class="hint">Noch keine Gegner mit bestätigten Spielen.</p>
<% } else { %>
  <div class="card table-wrap">
    <table class="table">
      <thead>
        <tr><th>Gegner</th><th>Spiele</th><th>Siege</th><th>Niederlagen</th><th>Winrate</th></tr>
      </thead>
      <tbody>
        <% opponents.forEach(o => { %>
          <tr>
            <td>
              <a href="/stats/<%= o.username %>" class="leaderboard-player">
                <%- include('partials/avatar', { avatarFilename: o.avatar_filename, avatarUsername: o.username, avatarSize: 'sm' }) %>
                <%= o.username %>
              </a>
            </td>
            <td><%= o.games %></td>
            <td><%= o.wins %></td>
            <td><%= o.losses %></td>
            <td><%= o.winRate.toFixed(0) %>%</td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (teammates.length > 0) { %>
  <h2>Mit wem ist <%= stats.username %> gut?</h2>
  <div class="card table-wrap">
    <table class="table">
      <thead>
        <tr><th>Mitspieler</th><th>Spiele</th><th>Siege</th><th>Niederlagen</th><th>Winrate</th></tr>
      </thead>
      <tbody>
        <% teammates.forEach(t => { %>
          <tr>
            <td>
              <a href="/stats/<%= t.username %>" class="leaderboard-player">
                <%- include('partials/avatar', { avatarFilename: t.avatar_filename, avatarUsername: t.username, avatarSize: 'sm' }) %>
                <%= t.username %>
              </a>
            </td>
            <td><%= t.games %></td>
            <td><%= t.wins %></td>
            <td><%= t.losses %></td>
            <td><%= t.winRate.toFixed(0) %>%</td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<h2>Trefferverteilung</h2>
<% if (stats.games === 0) { %>
  <p class="hint">Noch keine Live-Party-Treffer &mdash; erscheint nach dem ersten Spiel.</p>
<% } else { %>
  <div class="card">
    <%- include('partials/heatmap', { cupTotals: cupHeatmap, cupTotalsMax: cupHeatmapMax }) %>
    <p class="hint">Zahl im Becher = Anzahl Treffer auf dieser Position, über alle Live-Party-Spiele.</p>
  </div>

  <h2>Erster Treffer</h2>
  <% if (firstHit.totalFirstHits === 0) { %>
    <p class="hint">Noch kein eigener Treffer in einem Spiel gelandet.</p>
  <% } else { %>
    <div class="card">
      <%- include('partials/heatmap', { cupTotals: firstHit.totals, cupTotalsMax: firstHitMax, heatmapLabel: 'x als erster Treffer' }) %>
      <p class="hint">
        Häufigster erster Treffer: Position <%= firstHit.topIndex + 1 %>
        (<%= firstHit.topCount %> von <%= firstHit.totalFirstHits %> Spielen,
        <%= ((firstHit.topCount / firstHit.totalFirstHits) * 100).toFixed(0) %>%).
      </p>
    </div>
  <% } %>
<% } %>

<h2>Letzte Spiele</h2>
<% if (history.length === 0) { %>
  <p class="hint">Keine bestätigten Spiele.</p>
<% } else { %>
  <ul class="match-list">
    <% history.forEach(m => { %>
      <li class="card match-item">
        <div>
          <strong><%= m.players.team1.join(' & ') %></strong> vs
          <strong><%= m.players.team2.join(' & ') %></strong>
          &mdash; <%= m.team1_score %> : <%= m.team2_score %>
          <span class="badge">Team <%= m.winner %> gewann</span>
        </div>
        <div class="hint small"><%= m.resolved_at %></div>
      </li>
    <% }) %>
  </ul>
<% } %>

<% if (isOwnProfile && !user.isManagement) { %>
  <h2>Gefahrenzone</h2>
  <div class="card danger-zone">
    <% if (deleteAccountError) { %><p class="error"><%= deleteAccountError %></p><% } %>
    <p class="hint">
      Löscht deinen Account unwiderruflich: Benutzername, Profilbild und Zugangsdaten werden entfernt. Ergebnisse
      gemeinsam gespielter Partys bleiben anonymisiert erhalten, damit die Statistiken deiner Mitspieler:innen
      korrekt bleiben. Mehr dazu in der <a href="/datenschutz">Datenschutzerklärung</a>.
    </p>
    <form action="/account/delete" method="POST" id="delete-account-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="button danger">Account löschen</button>
    </form>
  </div>
<% } %>

<script src="/js/account-delete.js?v=<%= assetVersion %>"></script>

<%- include('partials/footer') %>
