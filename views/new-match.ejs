<%- include('partials/header') %>

<h1>Neues Spiel eintragen</h1>
<p class="hint">Du bist automatisch Teil von Team 1. Der Gegner muss das Spiel danach bestätigen, damit es in die Statistik einfließt.</p>
<% if (error) { %><p class="error"><%= error %></p><% } %>

<form action="/matches/new" method="POST" class="card form" id="match-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <fieldset>
    <legend>Modus</legend>
    <label class="radio">
      <input type="radio" name="mode" value="1v1" <%= form.mode !== '2v2' ? 'checked' : '' %> />
      1 gegen 1
    </label>
    <label class="radio">
      <input type="radio" name="mode" value="2v2" <%= form.mode === '2v2' ? 'checked' : '' %> />
      2 gegen 2
    </label>
  </fieldset>

  <div id="teammate-field" class="hidden">
    <label>Mein Mitspieler (Team 1)
      <input type="text" name="teammate" value="<%= form.teammate || '' %>" />
    </label>
  </div>

  <label>Gegner 1 (Team 2)
    <input type="text" name="opponent1" required value="<%= form.opponent1 || '' %>" />
  </label>

  <div id="opponent2-field" class="hidden">
    <label>Gegner 2 (Team 2)
      <input type="text" name="opponent2" value="<%= form.opponent2 || '' %>" />
    </label>
  </div>

  <div class="score-row">
    <label>Becher Team 1
      <input type="number" name="team1_score" min="0" max="10" required value="<%= form.team1_score || '' %>" />
    </label>
    <label>Becher Team 2
      <input type="number" name="team2_score" min="0" max="10" required value="<%= form.team2_score || '' %>" />
    </label>
  </div>

  <button type="submit">Spiel speichern</button>
</form>

<script src="/js/new-match.js"></script>

<%- include('partials/footer') %>
