<%- include('partials/header') %>

<h1>Ausstehende Spiele</h1>

<h2>Von dir zu bestätigen</h2>
<% if (toConfirm.length === 0) { %>
  <p class="hint">Nichts zu bestätigen.</p>
<% } else { %>
  <ul class="match-list">
    <% toConfirm.forEach(m => { %>
      <li class="card match-item">
        <div>
          <strong><%= m.players.team1.join(' & ') %></strong> vs
          <strong><%= m.players.team2.join(' & ') %></strong>
          &mdash; <%= m.team1_score %> : <%= m.team2_score %>
          <span class="badge">Team <%= m.winner %> gewinnt</span>
        </div>
        <div class="match-actions">
          <form action="/matches/<%= m.id %>/confirm" method="POST" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="button small">Bestätigen</button>
          </form>
          <form action="/matches/<%= m.id %>/reject" method="POST" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="button small danger">Ablehnen</button>
          </form>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>

<h2>Warten auf Bestätigung durch andere</h2>
<% if (awaitingOthers.length === 0) { %>
  <p class="hint">Keine offenen Anfragen.</p>
<% } else { %>
  <ul class="match-list">
    <% awaitingOthers.forEach(m => { %>
      <li class="card match-item">
        <div>
          <strong><%= m.players.team1.join(' & ') %></strong> vs
          <strong><%= m.players.team2.join(' & ') %></strong>
          &mdash; <%= m.team1_score %> : <%= m.team2_score %>
          <span class="badge waiting">wartet</span>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/footer') %>
