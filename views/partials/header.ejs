<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · Bierpong Tracker</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">🍺 Bierpong Tracker</a>
    <nav>
      <% if (user) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/matches/new">Neues Spiel</a>
        <a href="/matches/pending">Ausstehend</a>
        <a href="/matches/history">Verlauf</a>
        <a href="/stats">Bestenliste</a>
        <a href="/stats/<%= user.username %>">Mein Profil</a>
        <form action="/logout" method="POST" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="link-button">Logout (<%= user.username %>)</button>
        </form>
      <% } else { %>
        <a href="/login">Login</a>
        <a href="/register">Registrieren</a>
      <% } %>
    </nav>
  </header>
  <main class="container">
