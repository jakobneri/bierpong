<%- include('../partials/header') %>

<h1>Admin-Dashboard</h1>

<div class="grid">
  <div class="card stat-card">
    <span class="stat-label">Nutzer (aktiv)</span>
    <span class="stat-value"><%= stats.activeUsers %> / <%= stats.users %></span>
  </div>
  <div class="card stat-card">
    <span class="stat-label">Bestätigte Spiele</span>
    <span class="stat-value"><%= stats.confirmedMatches %></span>
  </div>
  <div class="card stat-card">
    <span class="stat-label">Live-Partys</span>
    <span class="stat-value"><%= stats.liveParties %></span>
  </div>
</div>

<div class="actions">
  <a class="button" href="/admin/users">Nutzerverwaltung</a>
</div>

<h2>Neueste Registrierungen</h2>
<% if (recentUsers.length === 0) { %>
  <p class="hint">Noch keine Nutzer.</p>
<% } else { %>
  <ul class="match-list">
    <% recentUsers.forEach(u => { %>
      <li class="card match-item">
        <div>
          <strong><%= u.username %></strong>
          <% if (u.is_admin) { %><span class="badge">Admin</span><% } %>
        </div>
        <div class="hint small"><%= u.created_at %></div>
      </li>
    <% }) %>
  </ul>
<% } %>

<h2>Neueste Spiele</h2>
<% if (recentMatches.length === 0) { %>
  <p class="hint">Noch keine Spiele.</p>
<% } else { %>
  <ul class="match-list">
    <% recentMatches.forEach(m => { %>
      <li class="card match-item">
        <div>
          <strong><%= m.players.team1.join(' & ') %></strong> vs
          <strong><%= m.players.team2.join(' & ') %></strong>
          &mdash; <%= m.team1_score %> : <%= m.team2_score %>
          <span class="badge <%= m.status !== 'confirmed' ? 'waiting' : '' %>"><%= m.status %></span>
        </div>
        <div class="hint small"><%= m.created_at %></div>
      </li>
    <% }) %>
  </ul>
<% } %>

<h2>Aktivste Spieler</h2>
<% if (mostActivePlayers.length === 0) { %>
  <p class="hint">Noch keine bestätigten Spiele.</p>
<% } else { %>
  <div class="card table-wrap">
    <table class="table">
      <thead>
        <tr><th>Spieler</th><th>Spiele</th><th>Siege</th><th>Niederlagen</th><th>Winrate</th></tr>
      </thead>
      <tbody>
        <% mostActivePlayers.forEach(p => { %>
          <tr>
            <td>
              <a href="/stats/<%= p.username %>" class="leaderboard-player">
                <%- include('../partials/avatar', { avatarFilename: p.avatar_filename, avatarUsername: p.username, avatarSize: 'sm' }) %>
                <%= p.username %>
              </a>
            </td>
            <td><%= p.games %></td>
            <td><%= p.wins %></td>
            <td><%= p.losses %></td>
            <td><%= p.winRate.toFixed(0) %>%</td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (topRivalries.length > 0) { %>
  <h2>Häufigste Duelle</h2>
  <ul class="match-list">
    <% topRivalries.forEach(r => { %>
      <li class="card match-item">
        <div><strong><%= r.username1 %></strong> vs <strong><%= r.username2 %></strong></div>
        <div class="hint small"><%= r.games %> Spiele</div>
      </li>
    <% }) %>
  </ul>
<% } %>

<h2>Globale Trefferverteilung</h2>
<% if (stats.confirmedMatches === 0) { %>
  <p class="hint">Noch keine Live-Party-Treffer.</p>
<% } else { %>
  <div class="card">
    <%- include('../partials/heatmap', { cupTotals: cupHeatmap, cupTotalsMax: cupHeatmapMax }) %>
    <p class="hint">Zahl im Becher = Treffer auf dieser Position, über alle Spieler und Live-Partys hinweg.</p>
  </div>
<% } %>

<%- include('../partials/footer') %>
