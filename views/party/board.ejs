<%- include('../partials/header') %>

<h1>Live-Party</h1>
<p class="hint party-meta">
  Code: <strong class="party-code"><%= state.code %></strong> &middot; Modus <%= state.mode %>
  <button type="button" id="qr-toggle-btn" class="button small secondary">QR-Code</button>
</p>
<div id="qr-code-box" class="card qr-code-box hidden">
  <img src="/party/<%= state.code %>/qr.svg" width="220" height="220" alt="QR-Code zum Beitreten" />
  <p class="hint small">Code scannen, um direkt beizutreten.</p>
</div>

<div id="party-root"
  data-code="<%= state.code %>"
  data-status="<%= state.status %>"
  data-is-player="<%= isPlayer %>"
  data-my-team="<%= myTeam || '' %>"
  data-team1-ids="<%= state.players.team1.map(p => p.id).join(',') %>"
  data-team2-ids="<%= state.players.team2.map(p => p.id).join(',') %>">

  <% if (state.status === 'waiting') { %>
    <div class="card">
      <h2>Team 1</h2>
      <ul class="player-list">
        <% state.players.team1.forEach(p => { %>
          <li class="player-list-item">
            <%- include('../partials/avatar', { avatarFilename: p.avatarFilename, avatarUsername: p.username, avatarSize: 'sm' }) %>
            <%= p.username %>
          </li>
        <% }) %>
        <% for (let i = state.players.team1.length; i < state.maxPerTeam; i++) { %><li class="empty-slot">frei</li><% } %>
      </ul>
    </div>

    <div class="card">
      <h2>Team 2</h2>
      <ul class="player-list">
        <% state.players.team2.forEach(p => { %>
          <li class="player-list-item">
            <%- include('../partials/avatar', { avatarFilename: p.avatarFilename, avatarUsername: p.username, avatarSize: 'sm' }) %>
            <%= p.username %>
          </li>
        <% }) %>
        <% for (let i = state.players.team2.length; i < state.maxPerTeam; i++) { %><li class="empty-slot">frei</li><% } %>
      </ul>
    </div>

    <% if (!isPlayer && openTeams.length === 1) { %>
      <form action="/party/<%= state.code %>/join" method="POST" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="team" value="<%= openTeams[0] %>" />
        <button type="submit" class="button">Party beitreten</button>
      </form>
    <% } else if (!isPlayer && openTeams.length === 2) { %>
      <div class="actions">
        <form action="/party/<%= state.code %>/join" method="POST" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="team" value="1" />
          <button type="submit" class="button small">Team 1 beitreten</button>
        </form>
        <form action="/party/<%= state.code %>/join" method="POST" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="team" value="2" />
          <button type="submit" class="button small">Team 2 beitreten</button>
        </form>
      </div>
    <% } else if (!isPlayer && openTeams.length === 0) { %>
      <p class="hint">Diese Party ist bereits voll.</p>
    <% } %>

    <% if (isCreator) { %>
      <% const full = openTeams.length === 0; %>
      <form action="/party/<%= state.code %>/start" method="POST" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="button" <%= full ? '' : 'disabled' %>>
          <%= full ? 'Spiel starten' : 'Warte auf Spieler...' %>
        </button>
      </form>
    <% } else if (isPlayer) { %>
      <p class="hint">Warte, bis der Host das Spiel startet...</p>
    <% } %>
  <% } else if (state.status === 'active') { %>
    <% const isMyTurn = myTeam !== null && myTeam === state.currentTurnTeam;
       const rackClass = (team) => {
         const own = team === myTeam;
         const tappable = isPlayer && isMyTurn && !own;
         return `rack${own ? ' rack-own' : ''}${tappable ? '' : ' rack-locked'}`;
       };
       const turnTeamNames = state.players[`team${state.currentTurnTeam}`].map(p => p.username).join(' & ');
    %>
    <div class="card cup-board">
      <h2 class="team-header">
        <span class="team-avatars">
          <% state.players.team1.forEach(p => { %>
            <%- include('../partials/avatar', { avatarFilename: p.avatarFilename, avatarUsername: p.username, avatarSize: 'sm' }) %>
          <% }) %>
        </span>
        <%= state.players.team1.map(p => p.username).join(' & ') %> (Team 1)
      </h2>
      <div class="<%= rackClass(1) %>" data-rack="1">
        <% [4,3,2,1].reduce((idx, rowSize) => { %>
          <div class="rack-row">
            <% for (let i = 0; i < rowSize; i++) { %>
              <button type="button" class="cup <%= state.team1Cups[idx + i] ? 'hit' : '' %>" data-team="1" data-index="<%= idx + i %>" aria-label="Becher <%= idx + i + 1 %> Team 1"></button>
            <% } %>
          </div>
        <% return idx + rowSize; }, 0); %>
      </div>

      <div class="turn-banner <%= isMyTurn ? 'my-turn' : '' %>" id="party-turn-banner">
        <%= isMyTurn
          ? `Du bist dran! (Wurf ${state.throwsThisTurn + 1}/${state.throwsPerTurn})`
          : `${turnTeamNames} ist dran (Wurf ${state.throwsThisTurn + 1}/${state.throwsPerTurn})` %>
      </div>

      <h2 class="team-header">
        <span class="team-avatars">
          <% state.players.team2.forEach(p => { %>
            <%- include('../partials/avatar', { avatarFilename: p.avatarFilename, avatarUsername: p.username, avatarSize: 'sm' }) %>
          <% }) %>
        </span>
        <%= state.players.team2.map(p => p.username).join(' & ') %> (Team 2)
      </h2>
      <div class="<%= rackClass(2) %>" data-rack="2">
        <% [4,3,2,1].reduce((idx, rowSize) => { %>
          <div class="rack-row">
            <% for (let i = 0; i < rowSize; i++) { %>
              <button type="button" class="cup <%= state.team2Cups[idx + i] ? 'hit' : '' %>" data-team="2" data-index="<%= idx + i %>" aria-label="Becher <%= idx + i + 1 %> Team 2"></button>
            <% } %>
          </div>
        <% return idx + rowSize; }, 0); %>
      </div>

      <% if (isPlayer) { %>
        <button type="button" id="party-miss-btn" class="solo-btn miss-btn party-miss-btn" <%= isMyTurn ? '' : 'disabled' %>>DANEBEN</button>
      <% } %>
      <p class="hint">Du triffst nur die Becher der Gegenseite. Nach <%= state.throwsPerTurn %> Wurf/Würfen ist die andere Seite dran.</p>
      <% if (state.bombEnabled) { %>
        <p class="hint bomb-hint">💣 Bomben-Regel aktiv: Zwei Treffer in Folge sprengen alle Nachbarbecher mit!</p>
      <% } %>
    </div>
  <% } else { %>
    <% const winnerTeam = state.team1Cups.every(Boolean) ? 2 : 1;
       const winners = state.players[`team${winnerTeam}`];
       const losers = state.players[`team${winnerTeam === 1 ? 2 : 1}`];
       const winnerScore = winnerTeam === 1 ? state.team2Cups.filter(Boolean).length : state.team1Cups.filter(Boolean).length;
       const loserScore = winnerTeam === 1 ? state.team1Cups.filter(Boolean).length : state.team2Cups.filter(Boolean).length;
    %>
    <div class="card victory-card">
      <div class="confetti" aria-hidden="true">
        <% for (let i = 1; i <= 14; i++) { %><span class="confetti-piece c<%= i %>"></span><% } %>
      </div>
      <p class="victory-trophy">🏆</p>
      <div class="winner-avatars">
        <% winners.forEach(p => { %>
          <%- include('../partials/avatar', { avatarFilename: p.avatarFilename, avatarUsername: p.username, avatarSize: 'lg' }) %>
        <% }) %>
      </div>
      <h2 class="winner-title"><%= winners.map(p => p.username).join(' & ') %> gewinnt!</h2>
      <p class="hint"><%= winnerScore %> : <%= loserScore %> gegen <%= losers.map(p => p.username).join(' & ') %></p>
      <% if (state.matchId) { %>
        <p><a href="/matches/history">Im Spielverlauf ansehen</a> &middot; <a href="/stats">Bestenliste</a></p>
      <% } %>
    </div>
  <% } %>

  <div id="party-live-banner" class="notice hidden"></div>
</div>

<script src="/socket.io/socket.io.js?v=<%= assetVersion %>"></script>
<script src="/js/party.js?v=<%= assetVersion %>"></script>

<%- include('../partials/footer') %>
