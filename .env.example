# Copy this file to .env and fill in real values before running in production.

# Required in production: long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the app listens on.
PORT=3000

# Set to "production" only once you're deployed behind a reverse proxy that
# terminates HTTPS. If set while accessing the app over plain http://, login
# will appear to silently fail (the session cookie requires https and never
# gets stored, which also breaks CSRF checks). Leave unset/development for
# local or LAN testing without TLS.
NODE_ENV=development

# Where the SQLite database file is stored. Leave unset to default to
# ./data in the project folder (writable by whichever user runs the app).
# Only set this to /data if you're running via the provided Dockerfile /
# docker-compose.yml, which mounts a writable volume there - setting it to
# /data outside Docker will fail because that path isn't writable.
#DATA_DIR=/data

# Optional: password for a dedicated "admin" management account. If set,
# a user named "admin" is created/kept in sync with this password on every
# startup, with admin rights but no player stats - it can't join parties,
# use solo training, or appear on the leaderboard, it can only access
# /admin. Leave unset if you don't want a separate management login (the
# first real account you register still becomes an admin automatically).
#ADMIN_PASSWORD=
