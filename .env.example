# Copy this file to .env and fill in real values before running in production.

# Required in production: long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the app listens on.
PORT=3000

# Set to "production" when deployed behind a reverse proxy with HTTPS.
NODE_ENV=production

# Optional: where the SQLite database file is stored (defaults to ./data).
DATA_DIR=/data
